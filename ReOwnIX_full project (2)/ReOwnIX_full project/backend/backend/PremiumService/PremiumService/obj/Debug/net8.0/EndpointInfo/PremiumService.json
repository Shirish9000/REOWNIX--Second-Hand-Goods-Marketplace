  "components": {
    "schemas": {
      "InvoiceRequestDto": {
        "required": [
          "paymentId"
        ],
        "type": "object",
        "properties": {
          "paymentId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Payment ID for which the invoice is generated.",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Request DTO used to generate an invoice for a payment."
      },
      "PaymentRequestDto": {
        "required": [
          "amount",
          "paymentMethod",
          "planId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "User ID.",
            "format": "int32"
          },
          "planId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Selected plan ID.",
            "format": "int32"
          },
          "amount": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "description": "Amount to be paid.",
            "format": "currency"
          },
          "paymentMethod": {
            "maxLength": 30,
            "minLength": 3,
            "type": "string",
            "description": "Payment method.\r\nExample: UPI, Credit Card, Debit Card, Net Banking."
          }
        },
        "additionalProperties": false,
        "description": "Request DTO used to process a payment for a subscription plan."
      },
      "PlanRequestDto": {
        "required": [
          "durationDays",
          "planName",
          "price",
          "productLimit"
        ],
        "type": "object",
        "properties": {
          "planName": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "description": "Name of the subscription plan."
          },
          "price": {
            "maximum": 100000,
            "minimum": 0.01,
            "type": "number",
            "description": "Price of the plan.",
            "format": "currency"
          },
          "productLimit": {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer",
            "description": "Maximum number of products the user can view.",
            "format": "int32"
          },
          "durationDays": {
            "maximum": 365,
            "minimum": 1,
            "type": "integer",
            "description": "Duration of the subscription in days.",
            "format": "int32"
          },
          "description": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Optional plan description.",
            "nullable": true
          },
          "isActive": {
            "type": "boolean",
            "description": "Indicates whether the plan is active."
          }
        },
        "additionalProperties": false,
        "description": "Request DTO used to create or update a subscription plan."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "PurchasePlanRequestDto": {
        "required": [
          "planId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "userId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "User ID.",
            "format": "int32"
          },
          "planId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Plan ID to purchase.",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Request DTO used to purchase a subscription plan."
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Enter JWT Token: Bearer {your_token}",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ]
}